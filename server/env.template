# MongoDB Connection (use your own Atlas connection string; URL-encode special chars in the password)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority

# JWT Secret (use a long random string in production)
JWT_SECRET=change-this-to-a-strong-random-secret

# Server Port
PORT=5000

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Google OAuth
# Get these from https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Facebook OAuth
# Get these from https://developers.facebook.com/
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret

# Image Search API Keys (Optional - for better college image search)
GOOGLE_CSE_API_KEY=your-google-cse-api-key
GOOGLE_CSE_ID=your-google-cse-id
BING_IMAGE_SEARCH_API_KEY=your-bing-image-search-api-key
UNSPLASH_ACCESS_KEY=your-unsplash-access-key

# Get SerpAPI key from https://serpapi.com/ (free tier: 100 searches/month)
SERP_API_KEY=your-serpapi-key

# Email (SMTP) - optional
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password

# Gemini AI (chatbot)
GEMINI_API_KEY=your-gemini-api-key
